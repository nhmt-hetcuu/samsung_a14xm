# Removable storage
/external_sd            auto      /dev/block/mmcblk0p1 /dev/block/mmcblk0       flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg                auto      /dev/block/sdd1 /dev/block/sdd               flags=display="USB-OTG";storage;wipeingui;removable

# Flashable dynamic partitions
/system_image           emmc      /dev/block/mapper/system                     flags=backup=0;flashimg;display="System Image"
/vendor_image           emmc      /dev/block/mapper/vendor                     flags=backup=0;flashimg;display="Vendor Image"
/product_image          emmc      /dev/block/mapper/product                    flags=backup=0;flashimg;display="Product Image"
/odm_image              emmc      /dev/block/mapper/odm                        flags=backup=0;flashimg;display="ODM Image"
/system_ext_image       emmc      /dev/block/mapper/system_ext                 flags=backup=0;flashimg;display="System EXT Image"
/vendor_dlkm_image      emmc      /dev/block/mapper/vendor_dlkm                flags=backup=0;flashimg;display="Vendor DLKM Image"
/system_dlkm_image      emmc      /dev/block/mapper/system_dlkm                flags=backup=0;flashimg;display="System DLKM Image"
/odm_dlkm_image         emmc      /dev/block/mapper/odm_dlkm                   flags=backup=0;flashimg;display="ODM DLKM Image"

# Boot & Recovery partitions
/boot                   emmc      /dev/block/by-name/boot                      flags=backup=1;display="Boot";flashimg=1
/recovery               emmc      /dev/block/by-name/recovery                  flags=backup=1;display="Recovery";flashimg=1
/init_boot              emmc      /dev/block/by-name/init_boot                 flags=backup=1;display="Init Boot";flashimg=1
/vendor_boot            emmc      /dev/block/by-name/vendor_boot               flags=backup=1;display="Vendor Boot";flashimg=1
/dtbo                   emmc      /dev/block/by-name/dtbo                      flags=backup=1;display="DTBO";flashimg=1
/vbmeta_system          emmc      /dev/block/by-name/vbmeta_system             flags=backup=1;display="VBMeta System";flashimg=1
/vbmeta_samsung         emmc      /dev/block/by-name/vbmeta_samsung            flags=backup=1;display="VBMeta Samsung";flashimg=1

# NVRAM / Baseband / EFS
/efs                    ext4      /dev/block/by-name/sec_efs                   flags=backup=1;display="EFS"
/nvram                  emmc      /dev/block/by-name/nvram                     flags=backup=1;display="NVRAM"
/nvdata                 emmc      /dev/block/by-name/nvdata                    flags=backup=1;display="NVDATA";subpartitionof=/nvram
/nvcfg                  emmc      /dev/block/by-name/nvcfg                     flags=backup=1;display="NVCFG";subpartitionof=/nvram

# Samsung partitions
/optics                 ext4      /dev/block/by-name/optics                    flags=backup=1;display="Optics";flashimg=1
/prism                  ext4      /dev/block/by-name/prism                     flags=backup=1;display="Prism";flashimg=1
/prism_image            emmc      /dev/block/by-name/prism                     flags=backup=0;display="Prism Image";flashimg=1
/optics_image           emmc      /dev/block/by-name/optics                    flags=backup=0;display="Optics Image";flashimg=1
